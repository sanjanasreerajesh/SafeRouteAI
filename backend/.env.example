# SafeRoute AI — Backend Environment Variables

# Database (PostgreSQL recommended for production; SQLite used if unset)
DATABASE_URL=postgresql://user:password@localhost:5432/safroute

# Google Maps APIs (optional — OSM + OSRM used as free fallbacks)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=

# Posture analysis module (set false to disable)
POSTURE_ENABLED=true

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase Cloud Messaging (optional)
FCM_SERVER_KEY=
